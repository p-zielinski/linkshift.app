# Backend tools local config
NODE_ENV=development
PORT=3030

# Frontend origins allowed for browser calls
APP_WEB_URL=http://localhost:4200
APP_TOOLS_BASE_URL=http://localhost:3030
CORS_ORIGINS=http://localhost:4200,http://localhost:3030
TRUST_PROXY=false

# Redis for public rate limiting
# For local repo docker-compose Redis use port 6767 + password changeme
REDIS_HOST=localhost
REDIS_PORT=6767
REDIS_USERNAME=default
REDIS_PASSWORD=changeme

# Public tools limits (per IP / minute)
QR_RATE_LIMIT_PER_MINUTE=600
TRACE_RATE_LIMIT_PER_MINUTE=240

# Docs assistant (POST /api/v1/public/docs/search)
OPENAI_API_KEY=
DOCS_ASSISTANT_ROUTER_MODEL=gpt-5.4-nano
DOCS_ASSISTANT_GENERATOR_MODEL=gpt-5.4-mini
DOCS_ASSISTANT_RATE_LIMIT_PER_MINUTE=5
# Optional extra generator instructions (appended to system prompt; anti-hallucination rules still apply)
# DOCS_ASSISTANT_EXTRA_INSTRUCTIONS=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=
# TURNSTILE_SKIP_VERIFY=true
# Docs assistant logs (optional). Use a separate Supabase project for dev vs prod.
# Setup: backend-tools/supabase/README.md
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional
# Set to true only if you have pino-pretty installed in backend-tools
LOG_PRETTY=false
# SENTRY_DSN=
