INFRA_STACK_NAME=redirect-infra
APP_STACK_NAME=redirect-app

# Shared Swarm network for both stacks
SWARM_OVERLAY_NETWORK=redirect_inter-stack-network

# Registry images
BACKEND_IMAGE=ghcr.io/your-org/redirect-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/redirect-frontend:latest

# Caddy routing (set DNS/hosts for these)
FRONTEND_HOST=linkshift.app
BACKEND_HOST=api.linkshift.app
GRAFANA_HOST=grafana.linkshift.app
DOZZLE_HOST=dozzle.linkshift.app

# Caddy ACME (TLS)
CADDY_ACME_EMAIL=admin@linkshift.app

# Grafana admin password is provided via Docker secret: grafana_admin_password

# Frontend runtime config
APP_API_BASE_URL=https://api.example.com
APP_SITE_NAME=LinkShift.App
APP_SITE_TAGLINE=Signal-driven redirect automation
APP_SUPPORT_EMAIL=support@example.com
APP_LEGAL_NAME=Independent operator
APP_LEGAL_ADDRESS=Available upon request
APP_PRIVACY_EMAIL=privacy@example.com
APP_MIN_AGE=16
APP_LEGAL_VERSION=v1

# Backend core
NODE_ENV=production
PORT=3000
API_HOSTNAME=api.example.com
APP_WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
HOST_ID=prod-1
LEGAL_VERSION=v1
LEGAL_MIN_AGE=16
LEGAL_ENTITY_NAME=Independent operator
LEGAL_ENTITY_ADDRESS=Available upon request
PRIVACY_EMAIL=privacy@example.com

# Database
POSTGRES_USER=postgres
POSTGRES_DB=redirect

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default

# Billing (Lemon Squeezy)
LEMON_SQUEEZY_API_KEY=replace-with-api-key
LEMON_SQUEEZY_STORE_ID=replace-with-store-id
LEMON_SQUEEZY_PRODUCT_ID=replace-with-product-id
LEMON_SQUEEZY_WEBHOOK_SECRET=replace-with-webhook-secret
LEMON_SQUEEZY_SUCCESS_URL=http://localhost:4200/dashboard
LEMON_SQUEEZY_VARIANT_BASIC_MONTHLY_ID=replace-with-basic-monthly-variant-id
LEMON_SQUEEZY_VARIANT_BASIC_YEARLY_ID=replace-with-basic-yearly-variant-id
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY_ID=replace-with-pro-monthly-variant-id
LEMON_SQUEEZY_VARIANT_PRO_YEARLY_ID=replace-with-pro-yearly-variant-id

# Email (Zoho ZeptoMail)
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_ADDRESS=notifications@example.com
ZEPTOMAIL_FROM_NAME=Redirect
EMAIL_FROM="Redirect <notifications@example.com>"
