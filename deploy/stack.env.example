INFRA_STACK_NAME=linkshift-infra
APP_STACK_NAME=linkshift-app
TOOLS_INFRA_STACK_NAME=linkshift-tools-infra
TOOLS_APP_STACK_NAME=linkshift-tools-app

# Shared Swarm network for both stacks
SWARM_OVERLAY_NETWORK=redirect_inter-stack-network

# Registry images
BACKEND_IMAGE=ghcr.io/your-org/linkshift-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/linkshift-frontend:latest
BACKEND_TOOLS_IMAGE=ghcr.io/your-org/linkshift-backend-tools:latest

# Caddy routing (set DNS/hosts for these)
FRONTEND_HOST=linkshift.app
TOOLS_HOST=tools.linkshift.app
TOOLS_DOZZLE_HOST=dozzle-tools.linkshift.app
TOOLS_ADMIN_ALLOWLIST="100.64.0.0/10 127.0.0.1"
GRAFANA_HOST=grafana.linkshift.app
DOZZLE_HOST=dozzle.linkshift.app

# Caddy ACME (TLS)
CADDY_ACME_EMAIL=admin@linkshift.app

# Grafana admin password is provided via Docker secret: grafana_admin_password

# Frontend runtime config
APP_DOMAIN_TARGET_IP=46.225.119.185
APP_BASE_URL=https://linkshift.app
APP_TOOLS_BASE_URL=https://tools.linkshift.app
APP_SITE_NAME=LinkShift.App
APP_SITE_TAGLINE=Signal-driven redirect automation
APP_SUPPORT_EMAIL=support@linkshift.app
APP_LEGAL_NAME=Independent operator
APP_LEGAL_ADDRESS=Available upon request
APP_PRIVACY_EMAIL=privacy@linkshift.app
APP_MIN_AGE=16
APP_LEGAL_VERSION=v1

# Backend core
BACKEND_HOST=linkshift.app
NODE_ENV=production
PORT=3000
API_HOSTNAME=linkshift.app
APP_WEB_URL=https://linkshift.app
CORS_ORIGINS=https://linkshift.app
TRUST_PROXY=true
HOST_ID=prod-1
LEGAL_VERSION=v1
LEGAL_MIN_AGE=16
LEGAL_ENTITY_NAME=Independent operator
LEGAL_ENTITY_ADDRESS=Available upon request
PRIVACY_EMAIL=privacy@linkshift.app

# Database
POSTGRES_USER=postgres
POSTGRES_DB=linkshift

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default

# Billing (Lemon Squeezy)
LEMON_SQUEEZY_STORE_ID=288089
LEMON_SQUEEZY_PRODUCT_ID=858473
LEMON_SQUEEZY_WEBHOOK_SECRET=replace-with-webhook-secret
LEMON_SQUEEZY_SUCCESS_URL=https:/linkShift.app/dashboard
LEMON_SQUEEZY_VARIANT_BASIC_MONTHLY_ID=1352565
LEMON_SQUEEZY_VARIANT_BASIC_YEARLY_ID=1352566
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY_ID=1352567
LEMON_SQUEEZY_VARIANT_PRO_YEARLY_ID=1352568

# Email (Zoho ZeptoMail)
ZEPTOMAIL_API_URL=https://api.zeptomail.eu/v1.1/email
ZEPTOMAIL_FROM_ADDRESS=notifications@linkshift.app
ZEPTOMAIL_FROM_NAME=LinkShift.app
EMAIL_FROM="Redirect <notifications@linkshift.app>"
