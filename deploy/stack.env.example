INFRA_STACK_NAME=redirect-infra
APP_STACK_NAME=redirect-app

# Shared Swarm network for both stacks
TRAEFIK_SWARM_NETWORK=redirect_inter-stack-network

# Registry images
BACKEND_IMAGE=ghcr.io/your-org/redirect-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/redirect-frontend:latest

# Traefik routing (set DNS/hosts for these)
FRONTEND_HOST=app.example.com
BACKEND_HOST=api.example.com
GRAFANA_HOST=grafana.example.com
DOZZLE_HOST=dozzle.example.com

# VPN allowlist and basic auth for admin tools
VPN_ALLOWED_CIDR=10.8.0.0/24
TRAEFIK_ADMIN_USERS=admin:$apr1$replace-with-htpasswd-hash

# Grafana admin password (non-secret in env file; consider using secrets in prod)
GF_SECURITY_ADMIN_PASSWORD=change-me

# Frontend runtime config
APP_API_BASE_URL=https://api.example.com
APP_SITE_NAME=LinkShift.App
APP_SITE_TAGLINE=Signal-driven redirect automation
APP_SUPPORT_EMAIL=support@example.com
APP_LEGAL_NAME=Independent operator
APP_LEGAL_ADDRESS=Available upon request
APP_PRIVACY_EMAIL=privacy@example.com
APP_MIN_AGE=16
APP_LEGAL_VERSION=v1

# Backend core
NODE_ENV=production
PORT=3000
API_HOSTNAME=api.example.com
APP_WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUST_PROXY=true
HOST_ID=prod-1
LEGAL_VERSION=v1
LEGAL_MIN_AGE=16
LEGAL_ENTITY_NAME=Independent operator
LEGAL_ENTITY_ADDRESS=Available upon request
PRIVACY_EMAIL=privacy@example.com

# Traefik domain updates (Docker API)
TRAEFIK_UPDATE_ENABLED=true
TRAEFIK_TARGET_SERVICE=redirect-app_backend
TRAEFIK_ROUTER_RULE_LABEL=traefik.http.routers.backend.rule
TRAEFIK_BASE_HOSTS=api.example.com

# Traefik ACME (TLS)
TRAEFIK_ACME_EMAIL=admin@example.com

# Database
POSTGRES_USER=postgres
POSTGRES_DB=redirect

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=default

# Billing (Lemon Squeezy)
LEMON_SQUEEZY_STORE_ID=replace-with-store-id
LEMON_SQUEEZY_SUCCESS_URL=https://app.example.com/dashboard
LEMON_SQUEEZY_VARIANT_STARTER_ID=replace-with-starter-variant-id
LEMON_SQUEEZY_VARIANT_PRO_ID=replace-with-pro-variant-id

# Email (Zoho ZeptoMail)
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_ADDRESS=notifications@example.com
ZEPTOMAIL_FROM_NAME=Redirect
EMAIL_FROM="Redirect <notifications@example.com>"

# Safe Browsing
SAFE_BROWSING_CLIENT_ID=redirect-master
SAFE_BROWSING_CLIENT_VERSION=1.0.0
