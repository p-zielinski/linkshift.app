        "operationId": "createRedirectTest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRedirectTestRequest"
              }
            }
          }
        },
        "responses": {
