{
  "openapi": "3.1.0",
  "info": {
    "title": "LinkShift Management API (API Key Accessible Endpoints) — Link Map Entries",
    "version": "1.0.0",
    "summary": "Organization-scoped redirect management API",
    "description": "Organization-scoped Management API for redirect configuration, link maps, and operational checks.\nUse it to automate what you can also do in the LinkShift dashboard — without dashboard session cookies.\n\n**Authentication**\n- Send your key on every request: `X-API-Key: <your_key>` (preferred).\n- Alternative header supported by the backend: `Authorization: ApiKey <your_key>`.\n\n**Typical setup order**\n1. Domain group → custom domains and/or LinkShift subdomains → redirect rules (and optional link maps).\n2. Link map + entries when rules resolve keys instead of a fixed destination.\n3. Redirect tests + simulate for CI; analytics for traffic review.\n\n**Errors and recovery**\n- `401` — key missing, revoked, or wrong organization. Create or rotate a key in the dashboard (Organization → API keys).\n- `402` — API access isn't on your current plan. Upgrade subscription, then retry.\n- `429` — per-key rate limit for your plan. Back off with jitter; read current usage via GET /api/v1/organization/usage (don't hard-code limits).\n- `400` — request body or query failed validation; inspect `details` and `requestId` in the JSON body.\n- `404` — ID doesn't exist or isn't in your organization scope.\n\n**Dashboard-only**\nAPI key CRUD, billing checkout, and some analytics views aren't in this spec — they require signed-in dashboard auth.\n\n**Guides** (same concepts, more examples): *Getting started*, *Domains and groups*, *Redirect rules*, *Redirect rules — operations*, *Link map entries*.\nThis document contains only operations tagged \"Link Map Entries\".\nTag scope: Keys inside a link map. Supports cursor list, single CRUD, bulk delete (rollback), and import (up to 500 rows, create-only).\n"
  },
  "servers": [
    {
      "url": "https://linkshift.app",
      "description": "Production API host"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Link Map Entries",
      "description": "Keys inside a link map. Supports cursor list, single CRUD, bulk delete (rollback), and import (up to 500 rows, create-only).\n"
    }
  ],
  "paths": {
    "/api/v1/link-map-entries": {
      "get": {
        "tags": [
          "Link Map Entries"
        ],
        "summary": "List link map entries",
        "description": "Pages keys inside one `linkMapId` (default `limit` 20, max 100).\nResponse uses `hasMore` / `moreStartingAfterId` (no `dataType` field). Optional `search` scans keys and destinations (max 1024 chars).\n",
        "operationId": "listLinkMapEntries",
        "parameters": [
          {
            "name": "linkMapId",
            "in": "query",
            "required": true,
            "description": "Link map to list. Get IDs from list link maps or create link map; use the same ID on import and bulk delete.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum number of entries returned in one page.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Optional search string matched against entry keys and destinations.",
            "schema": {
              "type": "string",
              "maxLength": 1024
            }
          },
          {
            "name": "startAfterId",
            "in": "query",
            "required": false,
            "description": "Cursor token using the last item ID from previous page.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Link map entries list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkMapEntryListResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "post": {
        "tags": [
          "Link Map Entries"
        ],
        "summary": "Create link map entry",
        "description": "Adds one key→destination row. Keys are path/query fragments, not full URLs.\nReturns 400 on invalid key characters or destination URL; 404 when `linkMapId` is unknown.\nFor hundreds of rows, prefer POST import link map entries.\n",
        "operationId": "createLinkMapEntry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLinkMapEntryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created link map entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkMapEntry"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "tags": [
          "Link Map Entries"
        ],
        "summary": "Bulk-delete link map entries by ID",
        "description": "Soft-deletes up to 1,000 entries in one call — use to roll back a bad import without deleting the whole map.\nBody requires `linkMapId` plus `entryIds` from list/create/import responses.\nResponse `deletedCount` may be lower than requested when some IDs were already deleted. Returns 404 when the map ID is invalid.\n",
        "operationId": "deleteManyLinkMapEntries",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteLinkMapEntriesByIdRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delete summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deletedCount": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "deletedCount"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/link-map-entries/import": {
      "post": {
        "tags": [
          "Link Map Entries"
        ],
        "summary": "Import link map entries (bulk create)",
        "description": "Creates up to 500 entries per request (**create-only** — duplicate keys appear in `errors[]`, not updated).\nHTTP 200 even when some rows fail: check `importedCount`, `failedCount`, and `errors[].error` per row.\nRoll back partial imports with DELETE bulk (pass `importedEntryIds`). Returns 404 when `linkMapId` is invalid.\n",
        "operationId": "importLinkMapEntries",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportLinkMapEntriesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Import summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportLinkMapEntriesResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/link-map-entries/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/EntityId"
        }
      ],
      "get": {
        "tags": [
          "Link Map Entries"
        ],
        "summary": "Get link map entry by ID",
        "description": "Fetches one row (`key`, `keyNormalized`, `destination`, parent `linkMapId`).\nReturns 404 when soft-deleted or outside your organization.\n",
        "operationId": "getLinkMapEntry",
        "responses": {
          "200": {
            "description": "Link map entry details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkMapEntry"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "put": {
        "tags": [
          "Link Map Entries"
        ],
        "summary": "Update link map entry",
        "description": "Changes `key` and/or `destination` on one row (send at least one field).\nReturns 400 when validation fails (e.g. duplicate key); 404 when the entry ID is out of scope.\n",
        "operationId": "updateLinkMapEntry",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLinkMapEntryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated link map entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LinkMapEntry"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "402": {
            "$ref": "#/components/responses/PaymentRequired"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      },
      "delete": {
        "tags": [
          "Link Map Entries"
