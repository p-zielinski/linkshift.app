# Core
# NODE_ENV: "production" forces JSON logs, "development" uses pretty-print.
NODE_ENV=development
PORT=3000
API_HOSTNAME=localhost
CORS_ORIGINS=http://localhost:4200,http://localhost:4000
TRUST_PROXY=false
HOST_ID=local-dev
APP_WEB_URL=http://localhost:4200
LEGAL_VERSION=v1
LEGAL_MIN_AGE=16
LEGAL_ENTITY_NAME=Independent operator
LEGAL_ENTITY_ADDRESS=Available upon request
PRIVACY_EMAIL=privacy@example.com

# Observability
# SENTRY_DSN: Required for error tracking (GlitchTip/Sentry).
SENTRY_DSN=
# GF_SECURITY_ADMIN_PASSWORD: Grafana admin password when running docker-compose.
GF_SECURITY_ADMIN_PASSWORD=

# Traefik (Docker API)
# TRAEFIK_UPDATE_ENABLED: Enable dynamic Traefik rule updates in production.
TRAEFIK_UPDATE_ENABLED=false
# TRAEFIK_TARGET_SERVICE: Swarm service name to update (e.g. redirect-app_backend).
TRAEFIK_TARGET_SERVICE=
# TRAEFIK_ROUTER_RULE_LABEL: Label key to update on the target service.
TRAEFIK_ROUTER_RULE_LABEL=traefik.http.routers.backend.rule
# TRAEFIK_BASE_HOSTS: Comma-separated base hosts to always include.
TRAEFIK_BASE_HOSTS=
# DOCKER_SOCKET_PATH: Path to Docker socket (default /var/run/docker.sock).
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=changeme

# Auth
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-secret
JWT_REFRESH_EXPIRES_IN=7d

# Lemon Squeezy (billing)
LEMON_SQUEEZY_API_KEY=replace-with-api-key
LEMON_SQUEEZY_STORE_ID=replace-with-store-id
LEMON_SQUEEZY_PRODUCT_ID=replace-with-product-id
LEMON_SQUEEZY_WEBHOOK_SECRET=replace-with-webhook-secret
LEMON_SQUEEZY_SUCCESS_URL=http://localhost:4200/dashboard
LEMON_SQUEEZY_VARIANT_BASIC_MONTHLY_ID=replace-with-basic-monthly-variant-id
LEMON_SQUEEZY_VARIANT_BASIC_YEARLY_ID=replace-with-basic-yearly-variant-id
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY_ID=replace-with-pro-monthly-variant-id
LEMON_SQUEEZY_VARIANT_PRO_YEARLY_ID=replace-with-pro-yearly-variant-id

# Email (Zoho ZeptoMail)
ZEPTOMAIL_API_KEY=replace-with-zeptomail-api-key
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_ADDRESS=notifications@example.com
ZEPTOMAIL_FROM_NAME=Redirect
EMAIL_FROM="Redirect <notifications@example.com>"

# Optional (ngrok local dev)
NGROK_AUTH_TOKEN=replace-with-ngrok-token
NGROK_URL=https://example.ngrok.app
DEV_NGROK_ORG_ID=org_example
DEV_NGROK_ORG_EMAIL=owner@example.com
DEV_NGROK_DOMAIN_GROUP_ID=dmg_example


SAFE_BROWSING_API_KEY=
SAFE_BROWSING_CLIENT_ID=
SAFE_BROWSING_CLIENT_VERSION=
