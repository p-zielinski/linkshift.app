// Prisma Schema for Redirect Management API
// PostgreSQL Database

generator client {
  provider = "prisma-client-js"
}

generator shared {
  provider = "prisma-client-js"
  output   = "../../shared/prisma-client"
}

datasource db {
  provider = "postgresql"
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
  HEAD
}

enum RedirectQueryMatch {
  exact
  ignore
  subset
}

enum RedirectPathMatch {
  exact
  prefix
}

enum RobotsPolicy {
  NONE
  ALLOW_ALL
  DISALLOW_ALL
  DISALLOW_BAD_BOTS
  CUSTOM
}

enum BillingCheckoutStatus {
  PENDING
  PAID
  CANCELED
  FAILED
  EXPIRED
}

// Organization entity - top-level tenant
model Organization {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Configuration for organization limits (JSONB)
  configuration Json?

  users        User[]
  domainGroups DomainGroup[]
  checkoutSessions BillingCheckoutSession[]
  redirectTests RedirectTest[]
  invites OrganizationInvite[]
  apiKeys ApiKey[]
  redirectRuleHitBreakdownHourly RedirectRuleHitBreakdownHourly[]

  @@index([deletedAt])
}

// User entity - belongs to one organization (1:1 relation)
model User {
  id             String   @id
  email          String   @unique
  passwordHash   String
  organizationId String
  isOwner        Boolean  @default(false)
  emailVerifiedAt DateTime?
  isBlocked      Boolean  @default(false)
  blockedAt      DateTime?
  termsAcceptedAt DateTime?
  privacyAcceptedAt DateTime?
  ageConfirmedAt DateTime?
  legalVersion   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkoutSessions BillingCheckoutSession[]
  createdInvites OrganizationInvite[] @relation("InviteCreatedBy")

  @@index([organizationId])
  @@index([deletedAt])
  @@index([email])
}

model OrganizationInvite {
  id              String   @id
  organizationId  String
  email           String
  tokenHash       String
  expiresAt       DateTime
  createdByUserId String
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
  @@index([expiresAt])
  @@index([acceptedAt])
}

model ApiKey {
  id             String   @id
  organizationId String
  name           String
  tokenHash      String   @unique
  tokenPrefix    String
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([deletedAt])
  @@index([expiresAt])
}

// DomainGroup entity - groups multiple domains with shared redirect rules
model DomainGroup {
  id             String   @id
  name           String
  organizationId String
  robotsPolicy   RobotsPolicy @default(NONE)
  customRobotsContent String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains       Domain[]
  linkShiftSubdomains LinkShiftSubdomain[]
  redirectRules RedirectRule[]
  linkMaps      LinkMap[]
  redirectTests RedirectTest[]

  @@index([organizationId])
  @@index([deletedAt])
}

// Domain entity - individual hostname (e.g., google.com, www.google.com)
model Domain {
  id            String   @id
  name          String   // Hostname must be unique among active domains
  domainGroupId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  domainGroup DomainGroup @relation(fields: [domainGroupId], references: [id], onDelete: Cascade)

  @@index([name]) // Critical for high-speed lookups
  @@index([domainGroupId])
  @@index([deletedAt])
}

// LinkShiftSubdomain entity - subdomain label used with LinkShift base domain (e.g., demo.linkshift.app)
model LinkShiftSubdomain {
  id            String   @id
  name          String   // Subdomain label before base host (a-z0-9-), max 30 chars
  domainGroupId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  domainGroup DomainGroup @relation(fields: [domainGroupId], references: [id], onDelete: Cascade)

  @@index([name]) // Critical for high-speed lookups
  @@index([domainGroupId])
  @@index([deletedAt])
}

// RedirectRule entity - defines redirection logic
model RedirectRule {
  id            String   @id
  source        String   // Source path or regex pattern
  destination   String?  // Target URL with variable support (nullable for link maps)
  statusCode    Int      @default(302) // HTTP status code (301 or 302)
  matchMethod   HttpMethod[] @default([]) // Empty array means all methods.
  queryMatch    RedirectQueryMatch @default(exact)
  pathMatch     RedirectPathMatch @default(exact)
  linkMapId     String?
  isBlocked     Boolean  @default(false)
  blockedAt     DateTime?
  priority      Int      @default(0) // For rule ordering (higher priority = evaluated first)
  domainGroupId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  domainGroup DomainGroup @relation(fields: [domainGroupId], references: [id], onDelete: Cascade)
  linkMap    LinkMap? @relation(fields: [linkMapId], references: [id], onDelete: SetNull)
  hitBreakdownHourly RedirectRuleHitBreakdownHourly[]

  @@index([domainGroupId])
  @@index([deletedAt])
  @@index([priority])
  @@index([isBlocked])

    // Enables Prisma cursor pagination aligned with ordering:
    // priority desc, createdAt desc, id desc
  @@unique([priority, createdAt, id])

    // Optional but recommended for performance of list queries
  @@index([domainGroupId, deletedAt, priority, createdAt, id])
}

model LinkMap {
  id                  String   @id
  name                String
  domainGroupId       String
  caseSensitive       Boolean  @default(false)
  queryMatch          RedirectQueryMatch @default(ignore)
  fallbackDestination String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  domainGroup  DomainGroup @relation(fields: [domainGroupId], references: [id], onDelete: Cascade)
  entries      LinkMapEntry[]
  redirectRules RedirectRule[]

  @@index([domainGroupId])
  @@index([deletedAt])
}

model LinkMapEntry {
  id            String   @id
  linkMapId     String
  key           String
  keyNormalized String
  destination   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  linkMap LinkMap @relation(fields: [linkMapId], references: [id], onDelete: Cascade)

  @@unique([linkMapId, keyNormalized])
  @@index([linkMapId])
  @@index([deletedAt])
}

model RedirectRuleHitBreakdownHourly {
  ruleId         String
  organizationId String
  bucketStart    DateTime
  fingerprint    String
  requestMethod  String
  requestPath    String
  requestQuery   String
  requestUrl     String
  destination    String
  linkMapKey     String?
  hits           Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  redirectRule RedirectRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([ruleId, organizationId, bucketStart, fingerprint])
  @@index([organizationId, bucketStart])
  @@index([ruleId, bucketStart])
  @@index([organizationId, ruleId, bucketStart])
}

// RedirectTest entity - stored redirect simulations
model RedirectTest {
  id             String   @id
  organizationId String
  domainGroupId  String
  pathWithQuery  String
  requestData    Json
  expectedResult Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domainGroup  DomainGroup  @relation(fields: [domainGroupId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([domainGroupId])
  @@index([deletedAt])
  @@index([pathWithQuery])
  @@unique([createdAt, id])
  @@index([organizationId, deletedAt, createdAt, id])
}

model BillingCheckoutSession {
  id                     String                @id
  organizationId         String
  userId                 String
  plan                   String
  status                 BillingCheckoutStatus @default(PENDING)
  providerCheckoutId     String?
  providerOrderId        String?
  providerSubscriptionId String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  completedAt            DateTime?
  metadata               Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([providerCheckoutId])
  @@index([providerSubscriptionId])
}
