{
  "name": "project-4",
  "scripts": {
    "docs:links:check": "node scripts/check-docs-links.mjs",
    "docs:sync": "node scripts/check-docs-links.mjs && node scripts/docs-sync.mjs",
    "docs:summaries": "node scripts/docs-summaries.mjs",
    "docs:summaries:all": "node scripts/docs-summaries.mjs --all",
    "docs:summaries:dry-run": "node scripts/docs-summaries.mjs --dry-run",
    "docs:openapi:split": "node scripts/openapi-split-by-tag.mjs",
    "docs:openapi:split:yaml": "node scripts/openapi-split-by-tag.mjs --format yaml",
    "dev": "concurrently \"cd backend;bun run start:dev\" \"cd backend-tools;bun run start:dev\" \"cd frontend;npm run dev\"",
    "build": "cd backend && bun run build && cd ../backend-tools && bun run build && cd ../frontend && npm run build",
    "prepare": "husky",
    "precommit-check": "npm run build && echo 'Build passed!' || (echo 'Build failed! Commit aborted.' && exit 1)"
  },
  "lint-staged": {
    "frontend/src/**/*.html": [
      "npm --prefix frontend run format:templates --"
    ]
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "http-status-codes": "^2.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0"
  }
}
